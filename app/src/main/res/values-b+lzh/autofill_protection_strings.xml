    <string name="autofill_protection_title">自填服务护持</string>
    <string name="autofill_protection_entry_title">后台护持与无障碍之察</string>
    <string name="autofill_protection_entry_desc">察连接、自启动与电池限制，亦可择 Shizuku 增强复原。</string>
    <string name="autofill_protection_accessibility_connected">无障碍服务已连</string>
    <string name="autofill_protection_accessibility_disconnected">无障碍已启，尚未连通</string>
    <string name="autofill_protection_accessibility_disabled">无障碍服务未启</string>
    <string name="autofill_protection_accessibility_connected_desc">可用之登录页，可借无障碍回填，无须易键盘。</string>
    <string name="autofill_protection_accessibility_disconnected_desc">Android 或尚在连接，或限后台运行。请稍候重察；仍不通时，往系统之设停 Monica 无障碍，再启之。</string>
    <string name="autofill_protection_accessibility_disabled_desc">无障碍可读屏中文字，并操输入栏；信任 Monica 方宜启用。填入仍循原有密钥验证之设。</string>
    <string name="autofill_protection_accessibility_settings">理 Monica 无障碍</string>
    <string name="autofill_protection_background_title">后台护持</string>
    <string name="autofill_protection_background_desc">以安静常驻通知助自填常备；略增内存与电量之耗，随时可停。</string>
    <string name="autofill_protection_running">后台护持正行</string>
    <string name="autofill_protection_starting">正启后台护持……</string>
    <string name="autofill_protection_stopped">后台护持已停，请再试并察系统限制。</string>
    <string name="autofill_protection_boot_desc">启后，重启设备并首次启封时，自复护持。部分手机另须自启动权限；若系统强停应用，须亲开 Monica。</string>
    <string name="autofill_protection_vault_desc">后台护持不启封密府；停之亦停 Shizuku 增强复原。</string>
    <string name="autofill_protection_battery_title">电池优化</string>
    <string name="autofill_protection_battery_desc">可许 Monica 免电池优化之限，使熄屏后更易取用；惟或增后台电耗。</string>
    <string name="autofill_protection_battery_exempt">电池优化之限已免，后台电耗或增。</string>
    <string name="autofill_protection_autostart_title">自启动与后台运行</string>
    <string name="autofill_protection_autostart_desc">请于手机之设准 Monica 自启动、后台运行；厂商各异，须于系统页察之。</string>
    <string name="autofill_protection_background_restricted">Android 正限后台运行，请于应用之设准后台活动与自启动。</string>
    <string name="autofill_protection_notifications_allowed">通知已准。若不见自填提示，请察系统通知分类。</string>
    <string name="autofill_protection_notifications_blocked">通知未准，自填提示与护持之况或不能见。</string>
    <string name="autofill_protection_channel">自填服务护持</string>
    <string name="autofill_protection_notification_title">Monica 自填服务护持</string>
    <string name="autofill_protection_notification_connected">无障碍已连 · 按此管理</string>
    <string name="autofill_protection_notification_disconnected">无障碍未连 · 按此察验</string>
    <string name="autofill_protection_notification_disabled">无障碍未启 · 按此设之</string>
    <string name="autofill_protection_stop">停护持</string>
