<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="autofill_protection_title">填充服務保護</string>
    <string name="autofill_protection_entry_title">後台保護與無障礙執行檢查</string>
    <string name="autofill_protection_entry_desc">檢查連線、自啓動和電池限制，可選 Shizuku 增強還原。</string>
    <string name="autofill_protection_accessibility_connected">無障礙服務執行中</string>
    <string name="autofill_protection_accessibility_disconnected">無障礙已開啓，但尚未連線</string>
    <string name="autofill_protection_accessibility_disabled">尚未開啓無障礙服務</string>
    <string name="autofill_protection_accessibility_connected_desc">支援的登入頁面可通過無障礙回填，無需切換輸入法。</string>
    <string name="autofill_protection_accessibility_disconnected_desc">系統可能仍在連線或限制了後台執行。稍候刷新；仍無法連線時，請到系統設定關閉並重新開啓 Monica 無障礙。</string>
    <string name="autofill_protection_accessibility_disabled_desc">無障礙可讀取屏幕內容並操作輸入框，請僅在信任 Monica 時啟用。填充時仍遵循原有的密碼驗證設定。</string>
    <string name="autofill_protection_accessibility_settings">管理 Monica 無障礙</string>
    <string name="autofill_protection_background_title">後台保護</string>
    <string name="autofill_protection_background_desc">顯示安靜的常駐通知，幫助填充服務保持可用。會增加少量記憶體與電量佔用，可隨時關閉。</string>
    <string name="autofill_protection_running">後台保護執行中</string>
    <string name="autofill_protection_starting">正在啓動後台保護…</string>
    <string name="autofill_protection_stopped">後台保護未執行，請重試並檢查系統限制。</string>
    <string name="autofill_protection_boot_desc">開啓後，在手機重啓並首次解鎖時自動還原後台保護。部分手機還需允許自啓動；系統強行停止應用程式後，需要手動開啟 Monica。</string>
    <string name="autofill_protection_vault_desc">後台保護不會解鎖密碼庫。關閉後也會停用 Shizuku 增強還原。</string>
    <string name="autofill_protection_battery_title">電池優化</string>
    <string name="autofill_protection_battery_desc">可允許 Monica 不受電池優化限制，以改善息屏後的可用性；這可能增加後台耗電。</string>
    <string name="autofill_protection_battery_exempt">已解除電池優化限制，可能增加後台耗電。</string>
    <string name="autofill_protection_autostart_title">自啓動與後台執行</string>
    <string name="autofill_protection_autostart_desc">在手機設定中允許 Monica 自啓動和後台執行。各品牌設定不同，請在系統頁面確認。</string>
    <string name="autofill_protection_background_restricted">系統正在限制後台執行，請在應用程式設定中允許後台活動與自啓動。</string>
    <string name="autofill_protection_notifications_allowed">已允許通知；若收不到填充提示，請檢查系統中的通知類別。</string>
    <string name="autofill_protection_notifications_blocked">未允許通知，填充提示和後台狀態通知可能無法顯示。</string>
    <string name="autofill_protection_channel">填充服務保護</string>
    <string name="autofill_protection_notification_title">Monica 填充服務保護</string>
    <string name="autofill_protection_notification_connected">無障礙服務執行中 · 點此管理</string>
    <string name="autofill_protection_notification_disconnected">無障礙尚未連線 · 點此檢查</string>
    <string name="autofill_protection_notification_disabled">無障礙未開啓 · 點此設定</string>
    <string name="autofill_protection_stop">關閉保護</string>
    <string name="autofill_protection_start_failed">系統未能啓動後台保護，請檢查自啓動與後台執行限制後重試。</string>
    <string name="autofill_protection_settings_unavailable">無法開啟對應的系統頁面，請在手機設定中手動查找。</string>
    <string name="autofill_protection_shizuku_title">Shizuku 增強還原 · 可選</string>
    <string name="autofill_protection_shizuku_authorized">ADB 模式已授權</string>
    <string name="autofill_protection_shizuku_needs_permission">Shizuku 已執行，尚未授權 Monica</string>
    <string name="autofill_protection_shizuku_unavailable">Shizuku 未執行或尚未安裝</string>
    <string name="autofill_protection_shizuku_unsupported">需要 Shizuku 13 或更新版本的 ADB 模式</string>
    <string name="autofill_protection_shizuku_root">目前為 root 模式，本功能不使用此權限；請改用 ADB／無線調試模式。</string>
    <string name="autofill_protection_enhanced_title">無障礙增強還原</string>
    <string name="autofill_protection_enhanced_desc">嘗試重連已開啓但未連線的 Monica 服務。用戶關閉的無障礙不會自動開啓。</string>
    <string name="autofill_protection_enhanced_needs_background">請先開啓後台保護，再閱讀風險說明並授權。</string>
    <string name="autofill_protection_shizuku_open">開啟 Shizuku／使用說明</string>
    <string name="autofill_protection_shizuku_availability">Shizuku 停止或授權撤銷後，增強還原停止。ADB 模式在手機重啓後通常需要重新啓動 Shizuku。</string>
    <string name="autofill_protection_risk_title">啟用前瞭解系統授權風險</string>
    <string name="autofill_protection_risk_body">Shizuku 授權具有高於普通應用程式的系統權限，請僅向信任的應用程式授權。\n\n本功能僅接受 ADB／無線調試模式，短暫斷開並重新連線 Monica 已開啓的無障礙服務；不會執行 root 命令，也不讀取或修改密碼庫、備份及其他應用程式數據。\n\n還原可能失敗或暫時中斷填充，屆時需到系統設定手動重新開啓。偵測到其他無障礙設定同時變化時會停止操作，不覆蓋新的設定。\n\n非 root 方式啓動的 Shizuku 在重啓後通常需要重新啓動。關閉增強還原即可停止後續嘗試，也可在 Shizuku 中撤銷 Monica 的授權。</string>
    <string name="autofill_protection_risk_acknowledge">我瞭解上述權限範圍與風險</string>
    <string name="autofill_protection_risk_continue">繼續授權並啟用</string>
    <string name="autofill_protection_shizuku_denied">未獲得可用的 Shizuku ADB 授權，增強還原未開啓。</string>
    <string name="autofill_protection_recover_now">立即嘗試還原</string>
    <string name="autofill_protection_recovering">正在還原…</string>
    <string name="autofill_protection_recovery_success">Monica 無障礙服務已連線。</string>
    <string name="autofill_protection_recovery_disabled">無障礙已關閉，請先在系統設定中手動開啓。</string>
    <string name="autofill_protection_recovery_settings_changed">無障礙設定發生了變化，已停止覆蓋操作。請在系統設定中確認 Monica 的狀態。</string>
    <string name="autofill_protection_recovery_failed">未能還原連線，請在系統設定中關閉並重新開啓 Monica 無障礙。</string>
    <string name="autofill_protection_recovery_cooldown">為避免反覆切換，還原嘗試至少間隔 5 分鐘。也可直接到系統設定手動還原。</string>
</resources>
