<resources>
    <string name="qs_step_presets_title">프리셋 선택</string>
    <string name="qs_step_presets_subtitle">레이아웃을 먼저 고른 뒤 Dock과 각 페이지를 따로 조정하세요.</string>
    <string name="qs_dock_subtitle">Dock에 표시할 페이지와 순서를 정하세요.</string>
    <string name="qs_step_customize_title">페이지 세부 설정</string>
    <string name="qs_step_customize_subtitle">바꾸고 싶은 항목만 펼치세요. 나중에 설정에서도 변경할 수 있어요.</string>
    <string name="qs_step_protect_title">보안 및 자동 완성</string>
    <string name="qs_step_protect_subtitle">보관함을 보호하고 더 편하게 로그인하세요.</string>
    <string name="qs_ready_title">준비 완료</string>
    <string name="qs_ready_subtitle">이 레이아웃으로 시작해요. 언제든 설정에서 바꿀 수 있어요.</string>
    <string name="qs_save_failed">설정을 저장하지 못했어요. 다시 시도해 주세요.</string>
