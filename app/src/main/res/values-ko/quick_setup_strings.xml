    <string name="qs_preset_bitwarden_preview">Bitwarden · 미리보기</string>
    <string name="qs_preset_bitwarden_preview_desc">보관함 개요로 시작하고 Dock에 Send와 생성기를 배치해요.</string>
    <string name="qs_preset_bitwarden_list">Bitwarden · 목록</string>
    <string name="qs_preset_bitwarden_list_desc">보관함 목록을 바로 열고 Dock에 Send와 생성기를 배치해요.</string>
    <string name="qs_preset_authenticator">인증 코드 전용</string>
    <string name="qs_preset_authenticator_desc">인증기와 Steam으로 인증 코드를 빠르게 확인하세요.</string>
    <string name="qs_preset_paged">페이지별 관리</string>
    <string name="qs_preset_paged_desc">비밀번호, 인증기, 카드, 메모를 각각의 페이지로 나눠요.</string>
    <string name="qs_preset_everyday">일상용</string>
    <string name="qs_preset_everyday_desc">비밀번호, 인증기, 생성기를 한곳에서 빠르게 열어요.</string>
